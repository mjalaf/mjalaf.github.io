---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const MAX_RECENT_POSTS = 4;
const MAX_VISIBLE_TAGS = 15;

// Get and sort all blog posts
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = allPosts.slice(0, MAX_RECENT_POSTS);

// Collect tags and their usage counts
const tagCounts = new Map<string, number>();

for (const post of allPosts) {
    for (const tag of post.data.tags ?? []) {
        const normalizedTag = tag.trim();

        if (!normalizedTag) continue;

        tagCounts.set(
            normalizedTag,
            (tagCounts.get(normalizedTag) ?? 0) + 1
        );
    }
}

const sortedTags = [...tagCounts.entries()].sort(
    ([tagA, countA], [tagB, countB]) =>
        countB - countA || tagA.localeCompare(tagB)
);

const visibleTags = sortedTags.slice(0, MAX_VISIBLE_TAGS);
const remainingTags = sortedTags.slice(MAX_VISIBLE_TAGS);

// Collect publication years and counts
const yearCounts = new Map<number, number>();

for (const post of allPosts) {
    const year = post.data.pubDate.getFullYear();

    yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}

const sortedYears = [...yearCounts.entries()].sort(
    ([yearA], [yearB]) => yearB - yearA
);

// URL helpers
const getPostUrl = (postId: string) => `/blog/${postId}/`;

const getTagUrl = (tag: string) =>
    `/blog/tag/${encodeURIComponent(tag)}/`;

const getYearUrl = (year: number) =>
    `/blog/year/${year}/`;
---

<!doctype html>
<html lang="en" class="bg-black">
    <head>
        <BaseHead
            title={SITE_TITLE}
            description={SITE_DESCRIPTION}
        />
    </head>

    <body
        class="min-h-screen bg-black text-neutral-100 antialiased selection:bg-blue-600 selection:text-white"
    >
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-M4LH8GS"
                height="0"
                width="0"
                title="Google Tag Manager"
                style="display:none;visibility:hidden"
            ></iframe>
        </noscript>

        <Header />

        <main class="mx-auto max-w-6xl space-y-14 px-4 py-12">
            <!-- Hero -->
            <section
                aria-labelledby="hero-title"
                class="flex flex-col items-start py-6 max-sm:items-center max-sm:text-center"
            >
                <h1
                    id="hero-title"
                    class="text-4xl font-bold tracking-tight text-white max-sm:text-3xl"
                >
                    Hi, I'm
                    <span class="text-blue-500">Martin Jalaf</span>
                    👋
                </h1>

                <p
                    class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-400 max-sm:text-base"
                >
                    Lead Solution Architect with 20+ years of experience in
                    technology. I help organizations navigate architectural
                    complexity, reduce risk in large programs, and align cloud
                    strategy with real business outcomes. I work across the
                    Americas, supporting enterprise customers in the U.S. and
                    Latin America.
                </p>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="/blog"
                        class="rounded-lg bg-blue-600 px-5 py-2 text-sm font-medium text-white no-underline transition-colors duration-200 hover:bg-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
                    >
                        View Blog
                    </a>

                    <a
                        href="/about"
                        class="rounded-lg border border-neutral-800 bg-neutral-950 px-5 py-2 text-sm font-medium text-neutral-300 no-underline transition-colors duration-200 hover:border-neutral-700 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
                    >
                        About Me
                    </a>
                </div>
            </section>

            <hr class="border-neutral-900" />

            <!-- Recent Articles -->
            <section aria-labelledby="recent-articles-title">
                <div class="mb-6 flex items-center justify-between gap-4">
                    <h2
                        id="recent-articles-title"
                        class="text-2xl font-semibold tracking-tight text-white"
                    >
                        Recent Articles
                    </h2>

                    <a
                        href="/blog"
                        class="shrink-0 text-sm font-medium text-blue-400 no-underline transition-colors hover:text-blue-300 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
                    >
                        View all
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                {
                    recentPosts.length > 0 ? (
                        <div class="grid gap-6 sm:grid-cols-2">
                            {recentPosts.map((post) => (
                                <article class="group relative rounded-2xl border border-neutral-900 bg-neutral-950/80 p-6 transition-all duration-200 hover:border-neutral-800 hover:bg-neutral-900/50 focus-within:border-blue-500/70 focus-within:ring-2 focus-within:ring-blue-500/30">
                                    <a
                                        href={getPostUrl(post.id)}
                                        class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-none"
                                        aria-label={`Read article: ${post.data.title}`}
                                    />

                                    <div class="pointer-events-none relative z-20 space-y-3">
                                        <div class="flex flex-wrap items-center gap-3 text-xs text-neutral-500">
                                            <FormattedDate
                                                date={post.data.pubDate}
                                            />

                                            {post.data.tags &&
                                                post.data.tags.length > 0 && (
                                                    <div
                                                        class="pointer-events-auto relative z-30 flex flex-wrap gap-2"
                                                        aria-label="Article tags"
                                                    >
                                                        {post.data.tags
                                                            .slice(0, 2)
                                                            .map((tag) => (
                                                                <a
                                                                    href={getTagUrl(tag)}
                                                                    class="rounded-full border border-neutral-800 bg-neutral-900 px-2.5 py-0.5 text-xs text-neutral-400 no-underline transition-colors hover:border-neutral-700 hover:text-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
                                                                >
                                                                    #{tag}
                                                                </a>
                                                            ))}
                                                    </div>
                                                )}
                                        </div>

                                        <h3 class="text-lg font-semibold leading-snug text-neutral-100 transition-colors group-hover:text-blue-400">
                                            {post.data.title}
                                        </h3>

                                        {post.data.description && (
                                            <p class="line-clamp-3 text-sm leading-relaxed text-neutral-400">
                                                {post.data.description}
                                            </p>
                                        )}
                                    </div>
                                </article>
                            ))}
                        </div>
                    ) : (
                        <div class="rounded-2xl border border-neutral-900 bg-neutral-950 p-6">
                            <p class="text-sm text-neutral-400">
                                No articles have been published yet.
                            </p>
                        </div>
                    )
                }
            </section>

            <hr class="border-neutral-900" />

            <!-- Browse Articles -->
            <section
                aria-labelledby="browse-articles-title"
                class="pb-8"
            >
                <h2 id="browse-articles-title" class="sr-only">
                    Browse Articles
                </h2>

                <div class="grid gap-10 sm:grid-cols-2">
                    <!-- Browse by Tag -->
                    <nav aria-labelledby="browse-by-tag-title">
                        <h3
                            id="browse-by-tag-title"
                            class="mb-4 text-base font-semibold text-neutral-200"
                        >
                            Browse by Tag
                        </h3>

                        {
                            visibleTags.length > 0 ? (
                                <>
                                    <ul class="flex flex-wrap gap-2">
                                        {visibleTags.map(([tag, count]) => (
                                            <li>
                                                <a
                                                    href={getTagUrl(tag)}
                                                    class="inline-flex rounded-full border border-neutral-900 bg-neutral-950 px-3 py-1 text-xs text-neutral-400 no-underline transition-colors hover:border-neutral-700 hover:text-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
                                                >
                                                    #{tag}

                                                    <span class="ml-1 text-neutral-600">
                                                        ({count})
                                                    </span>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>

                                    {remainingTags.length > 0 && (
                                        <details class="mt-4">
                                            <summary class="cursor-pointer text-sm font-medium text-blue-400 transition-colors hover:text-blue-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                                                View all tags
                                            </summary>

                                            <ul class="mt-4 flex flex-wrap gap-2">
                                                {remainingTags.map(
                                                    ([tag, count]) => (
                                                        <li>
                                                            <a
                                                                href={getTagUrl(
                                                                    tag
                                                                )}
                                                                class="inline-flex rounded-full border border-neutral-900 bg-neutral-950 px-3 py-1 text-xs text-neutral-400 no-underline transition-colors hover:border-neutral-700 hover:text-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
                                                            >
                                                                #{tag}

                                                                <span class="ml-1 text-neutral-600">
                                                                    ({count})
                                                                </span>
                                                            </a>
                                                        </li>
                                                    )
                                                )}
                                            </ul>
                                        </details>
                                    )}
                                </>
                            ) : (
                                <p class="text-sm text-neutral-500">
                                    No tags are available yet.
                                </p>
                            )
                        }
                    </nav>

                    <!-- Browse by Year -->
                    <nav aria-labelledby="browse-by-year-title">
                        <h3
                            id="browse-by-year-title"
                            class="mb-4 text-base font-semibold text-neutral-200"
                        >
                            Browse by Year
                        </h3>

                        {
                            sortedYears.length > 0 ? (
                                <ul class="flex flex-wrap gap-2">
                                    {sortedYears.map(([year, count]) => (
                                        <li>
                                            <a
                                                href={getYearUrl(year)}
                                                class="inline-flex rounded-full border border-neutral-900 bg-neutral-950 px-3.5 py-1 text-xs text-neutral-400 no-underline transition-colors hover:border-neutral-700 hover:text-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
                                            >
                                                {year}

                                                <span class="ml-1 text-neutral-600">
                                                    ({count})
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            ) : (
                                <p class="text-sm text-neutral-500">
                                    No publication years are available yet.
                                </p>
                            )
                        }
                    </nav>
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>